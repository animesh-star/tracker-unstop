# ==========================================
# Unstop 30-Day Challenge Tracker - Environment
# ==========================================

# Server Port
PORT=3000

# Security: Secret Key for Protected Actions (solving challenges, backfilling days, testing alerts)
# When set, any mutating API request must include the header: `x-api-key: your_secret_here`
API_SECRET=animesh_secure_unstop_key_2026

# Allowed CORS Origins (comma-separated or * for local development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Push Notifications (Web Push VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:animesh.goswami045@gmail.com

# Mobile Notification Topic (ntfy.sh)
NTFY_TOPIC=animesh_unstop_streak
